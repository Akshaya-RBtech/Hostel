# WasteZero Environment Configuration
# =====================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ── Flask Secret Key (change to a random string for production) ──
SECRET_KEY=your-random-secret-key-here

# ── Gemini AI API Key (optional — app works without it) ──
GEMINI_API_KEY=your-gemini-api-key

# ── Admin Setup Secret (required for admin registration) ──
ADMIN_SETUP_SECRET=your-admin-setup-secret

# ── Firebase Configuration ──
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Server Port (optional, defaults to 5000) ──
PORT=5000
