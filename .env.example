# WasteZero Environment Configuration
# =====================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ── Flask Secret Key (change to a random string for production) ──
SECRET_KEY=your-random-secret-key-here

# ── Gemini AI API Key (optional — app works without it) ──
GEMINI_API_KEY=your_gemini_api_key_here
ADMIN_SETUP_SECRET=your_admin_secret_here
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=1:your_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Server Port (optional, defaults to 5000) ──
PORT=5000
